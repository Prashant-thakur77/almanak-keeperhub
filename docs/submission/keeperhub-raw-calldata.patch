+import { ethers } from "ethers";
+
+/**
+ * Turn raw EVM calldata into the typed call `POST /api/execute/contract-call`
+ * already executes: a function key plus a `functionArgs` JSON array string.
+ *
+ * Execution frameworks (Almanak, Wayfinder, AgentKit) hand their executor an
+ * already-encoded `data` field. Decoding it here, against an ABI the caller
+ * supplied or the explorer verified, keeps every downstream guard intact: the
+ * stablecoin cap, `simulate`, allowance and payable checks all keep reading a
+ * named function with typed arguments. Nothing is guessed: an ABI that does not
+ * contain the selector is an error, not a 4byte lookup.
+ */
+
+const HEX_PATTERN = /^0x[\da-fA-F]*$/;
+const SELECTOR_HEX_LENGTH = 10; // "0x" + 4 bytes
+
+export type RawCalldataResolution = {
+  /** Full signature, e.g. `approve(address,uint256)`, so overloads bind unambiguously. */
+  functionName: string;
+  /** JSON array string in the shape `functionArgs` accepts. */
+  functionArgs: string;
+  selector: string;
+};
+
+export type RawCalldataError = { error: string };
+
+export function isRawCalldataRequest(body: Record<string, unknown>): boolean {
+  return (
+    typeof body.data === "string" &&
+    !("functionName" in body) &&
+    !("abiFunction" in body)
+  );
+}
+
+export function selectorOf(data: string): string | RawCalldataError {
+  if (typeof data !== "string" || !HEX_PATTERN.test(data)) {
+    return { error: "data must be a 0x-prefixed hex string" };
+  }
+  if (data.length < SELECTOR_HEX_LENGTH || data.length % 2 !== 0) {
+    return {
+      error:
+        "data must carry at least a 4-byte function selector (plain value transfers use /api/execute/transfer)",
+    };
+  }
+  return data.slice(0, SELECTOR_HEX_LENGTH).toLowerCase();
+}
+
+/**
+ * Decode `data` against `abi`. The ABI must contain the selector; the caller
+ * decides where the ABI comes from (request body or explorer cache).
+ */
+export function resolveRawCalldata(
+  data: string,
+  abi: string
+): RawCalldataResolution | RawCalldataError {
+  const selector = selectorOf(data);
+  if (typeof selector !== "string") {
+    return selector;
+  }
+
+  let iface: ethers.Interface;
+  try {
+    iface = new ethers.Interface(JSON.parse(abi) as ethers.InterfaceAbi);
+  } catch {
+    return { error: "Invalid ABI JSON" };
+  }
+
+  let parsed: ethers.TransactionDescription | null;
+  try {
+    parsed = iface.parseTransaction({ data });
+  } catch (err: unknown) {
+    return {
+      error: `Calldata does not decode against the ABI: ${err instanceof Error ? err.message : String(err)}`,
+    };
+  }
+  if (parsed === null) {
+    return {
+      error: `Selector ${selector} is not in the ABI. Supply the contract's ABI in \`abi\`, or pass functionName and functionArgs instead of data.`,
+    };
+  }
+
+  const args = parsed.fragment.inputs.map((input, i) =>
+    toJsonArg(parsed.args[i], input)
+  );
+  return {
+    functionName: parsed.fragment.format("sighash"),
+    functionArgs: JSON.stringify(args),
+    selector,
+  };
+}
+
+/**
+ * Render one decoded value the way `functionArgs` expects it: decimal strings
+ * for integers, hex strings for bytes, arrays for arrays, objects keyed by
+ * component name for tuples. Mirrors what a caller would have typed by hand.
+ */
+function toJsonArg(value: unknown, input: ethers.ParamType): unknown {
+  if (input.baseType === "array") {
+    const items = Array.from(value as Iterable<unknown>);
+    const child = input.arrayChildren as ethers.ParamType;
+    return items.map((item) => toJsonArg(item, child));
+  }
+  if (input.baseType === "tuple") {
+    // reshapeArgsForAbi / coerceTuple (lib/abi/struct-args.ts) take a struct as an
+    // object keyed by component name; a nested array at the top level would be
+    // consumed as flat arguments. Unnamed components fall back to positional keys.
+    const components = input.components ?? [];
+    const items = Array.from(value as Iterable<unknown>);
+    const struct: Record<string, unknown> = {};
+    for (const [i, component] of components.entries()) {
+      struct[component.name || `c${i}`] = toJsonArg(items[i], component);
+    }
+    return struct;
+  }
+  if (typeof value === "bigint") {
+    return value.toString();
+  }
+  if (typeof value === "boolean") {
+    return value;
+  }
+  return String(value);
+}
