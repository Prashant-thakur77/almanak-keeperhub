+// #2426: `data` is an already-encoded call. The contract-call route decodes it
+// against the ABI into the function key and arguments the rest of this schema
+// describes, so `functionName` is required only in its absence. Shape is
+// checked here, before `resolveAbiForRequest` runs, because the missing
+// function key short-circuits this schema and nothing downstream would see it.
+const CALLDATA_REGEX = /^0x[\da-fA-F]*$/;
+const SELECTOR_HEX_LENGTH = 10; // "0x" + 4 bytes
+
+function hasRawCalldataInput(record: Record<string, unknown>): boolean {
+  return "data" in record;
+}
+
+function rawCalldataError(
+  record: Record<string, unknown>
+): ExecuteErrorResponse | null {
+  const data = record.data;
+  if (typeof data !== "string" || !CALLDATA_REGEX.test(data)) {
+    return {
+      error: "Invalid field type",
+      field: "data",
+      details: "data must be a 0x-prefixed hex string",
+    };
+  }
+  if (data.length % 2 !== 0) {
+    return {
+      error: "Invalid field value",
+      field: "data",
+      details: "data must contain whole bytes (an even number of hex digits)",
+    };
+  }
+  if (data.length < SELECTOR_HEX_LENGTH) {
+    return {
+      error: "Invalid field value",
+      field: "data",
+      details:
+        "data must carry at least a 4-byte function selector; a plain value transfer belongs on /api/execute/transfer",
+    };
+  }
+  return null;
+}
+
+// Both keys present is caller error for the same reason a functionName that
+// disagrees with abiFunction is: the two describe different transactions and
+// only one is what the caller meant. The route decodes `data`, so it would
+// silently win over the name that was typed.
+const dataFunctionNameConflict: ExecuteErrorResponse = {
+  error: "Conflicting field values",
+  field: "data",
+  details:
+    "data and functionName describe the same call twice; send raw calldata in data, or the function key and functionArgs, not both",
+};
+
 function requiredFieldError(field: string): ExecuteErrorResponse {
   return {
     error: "Missing required field",
@@ -186,7 +238,17 @@ export const contractCallInputSchema = objectBase.superRefine((record, ctx) => {
     addError(ctx, chainFieldError);
     return;
   }
-  if (!hasFunctionNameInput(record)) {
+  if (hasRawCalldataInput(record)) {
+    const dataError = rawCalldataError(record);
+    if (dataError) {
+      addError(ctx, dataError);
+      return;
+    }
+    if (hasFunctionNameInput(record)) {
+      addError(ctx, dataFunctionNameConflict);
+      return;
+    }
+  } else if (!hasFunctionNameInput(record)) {
     addError(ctx, requiredFieldError("functionName"));
     return;
   }
