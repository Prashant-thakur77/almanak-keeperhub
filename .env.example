# KeeperHub organization API key (Settings > API keys). Scope mcp:write to broadcast; mcp:read is enough for dry runs.
KEEPERHUB_API_KEY=kh_...
# Optional: hosted app by default.
KEEPERHUB_BASE_URL=https://app.keeperhub.com
# Optional: skip the GET /api/user lookup at gateway boot.
# KEEPERHUB_WALLET_ADDRESS=0x...

# RPC Almanak uses for reads (balances, prices) and this package uses for receipt logs.
# The public Base RPC rate-limits; a free Alchemy, dRPC or Blast key is more reliable for a strategy tick.
ALMANAK_BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_URL=https://mainnet.base.org
RPC_URL_BASE=https://mainnet.base.org

# Set automatically by `almanak-keeperhub run` from config.json "chain"; only needed for plain `almanak strat run`.
# ALMANAK_GATEWAY_WALLETS={"base": {"kind": "keeperhub"}}

# Optional: separates idempotency keys between deliberate re-runs of identical work within 24 h.
# ALMANAK_KEEPERHUB_IDEMPOTENCY_SALT=run-2

# Optional: Almanak production shape (one Safe per chain). Requires the Safe configured as the
# organization sender in KeeperHub (docs/wallet-management/safe.md); untested on the hosted app.
# KEEPERHUB_SAFE_ADDRESS=0x...

# Free path (Base Sepolia). KeeperHub sponsors gas there; test USDC from https://faucet.circle.com.
# ALMANAK_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# ALMANAK_KEEPERHUB_CHAIN=base_sepolia        # switches the failure-mode demos and the benchmark
# ALMANAK_KEEPERHUB_VAULT=0x...                # your TestVault (scripts/deploy_test_vault.sh); default: the sepolia demo config

# Optional operator alerts (Telegram). Create a bot with @BotFather, message it once, then read your chat id
# from https://api.telegram.org/bot<token>/getUpdates. Unset = silent.
# ALMANAK_KEEPERHUB_TELEGRAM_BOT_TOKEN=123456:ABC...
# ALMANAK_KEEPERHUB_TELEGRAM_CHAT_ID=123456789
